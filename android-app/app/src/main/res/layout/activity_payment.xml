<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button android:id="@+id/langEnButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="English" android:backgroundTint="@color/gold" android:textColor="@color/bg" android:textSize="12sp" />

        <Button android:id="@+id/langAmButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="አማርኛ" android:backgroundTint="@color/panel" android:textColor="@color/text" android:textSize="12sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView android:id="@+id/statusChip" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/waiting_for_payment" android:textColor="@color/text_dim" android:textSize="13sp"
        android:background="@color/panel" android:padding="10dp" android:layout_marginBottom="24dp" />

    <!-- This is the "big name" the driver glances at -->
    <TextView android:id="@+id/senderNameText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="—" android:textColor="@color/text_dim" android:textSize="40sp" android:textStyle="bold"
        android:gravity="center" android:layout_marginBottom="14dp" />

    <TextView android:id="@+id/amountText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/gold" android:textSize="26sp" android:textStyle="bold" android:visibility="gone"
        android:layout_marginBottom="10dp" />

    <TextView android:id="@+id/metaText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text_dim" android:textSize="12sp" android:gravity="center" />

    <Button android:id="@+id/repeatButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🔊 Repeat" android:backgroundTint="@color/panel" android:textColor="@color/text" android:layout_marginTop="28dp" />

    <!-- Only present for local testing without a real SIM/SMS; remove once verified on-device -->
    <Button android:id="@+id/testSmsButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Simulate test SMS" android:backgroundTint="@color/panel" android:textColor="@color/text_dim" android:layout_marginTop="12dp" />

</LinearLayout>
