# Copy this file to .env and fill in real values, or export these as
# environment variables however you deploy (systemd, Docker, Render, etc.)
# Never commit a real .env file to git.

# Long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# The username is always "admin" on first run; this only sets the initial password.
# Change it immediately after your first login.
ADMIN_DEFAULT_PASSWORD=changeme123

# Deposit accounts shown to drivers during registration.
CBE_ACCOUNT=CBE 1000504617827
TELEBIRR_ACCOUNT=0932648394

PORT=4000
